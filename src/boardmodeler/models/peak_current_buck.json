  "supported_behaviors": [
    "fixed-frequency peak-current-mode switching of PH through an internal high-side switch (RON)",
    "VSENSE frequency foldback in steps of 1, 1/2, 1/4 and 1/8 at the FOLD6/FOLD4/FOLD2 thresholds",
    "cycle-by-cycle switch current limit ILIM with minimum on-time TONMIN and maximum duty DMAX",
    "transconductance error amplifier (EAGM) with bounded source/sink current EAI into an external COMP network",
    "switch-current-to-COMP gain GMCS and Eco-mode pulse skipping below VECO / ECO_I",
    "EN threshold with hysteresis and EN pull-up current, so a floating EN enables",
    "VIN undervoltage lockout with hysteresis",
    "SS charge current ISS, SS-to-VSENSE offset and SS discharge while disabled",
    "operating (non-switching) and shutdown supply current"
  ],
  "unsupported_behaviors": [
    "temperature dependence and thermal shutdown",
    "BOOT capacitor undervoltage monitoring and 100 % duty-cycle dropout operation",
    "slope compensation, sub-harmonic behaviour and loop-bandwidth accuracy beyond the reduced amplifier",
    "switching-edge detail: dead time, ringing, diode reverse recovery, gate-drive loss",
    "overvoltage protection, output discharge and power-good (no PG pin)",
    "external clock synchronisation or programmable frequency (no RT/SYNC pin)",
    "internal compensation (parts without a COMP pin use a different topology)",
    "line/load transient accuracy, PSRR and noise"
  ]
}
